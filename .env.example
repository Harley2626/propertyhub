# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://thepropertypilot.co.za

# Google Analytics 4 — production only; leave unset in local development
# Create a GA4 property at https://analytics.google.com and copy the Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console — HTML tag verification (optional, server-only)
# Copy the content value from Search Console's "HTML tag" verification method
GOOGLE_SITE_VERIFICATION=

# Contact form — optional webhook for email delivery (e.g. Resend, Formspree)
# CONTACT_FORM_WEBHOOK_URL=
